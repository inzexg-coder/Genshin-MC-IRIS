# Teyvat (Genshin) — русские названия
# Экраны настроек (по одному контролу на группу)
screen.QUALITY=Качество графики
screen.BRIGHTNESS=Яркость
screen.RENDERING=Рендеринг
screen.SHADOWS=Качество теней
screen.POST_PROCESSING=Постобработка
screen.EFFECTS=Эффекты
screen.ENVIRONMENT=Детализация окружения
screen.FRAMERATE=Частота кадров
screen.BLUR=Размытие
screen.GLOW=Свечение
screen.ANTI_ALIASING=Сглаживание
screen.ENTITY_EFFECTS=Эффекты сущностей
screen.PLAYER_EFFECTS=Эффекты других игроков

# Контролы
option.TM_EXPOSURE=Яркость
option.TM_EXPOSURE.comment=Общая яркость картинки. Выше — светлее, ниже — темнее.
option.WORLD_SPACE_REFLECTIONS=Отражения
option.WORLD_SPACE_REFLECTIONS.comment=Отражения мира на воде и блоках. Дорого по FPS.
option.SHADOW_QUALITY=Качество теней
option.SHADOW_QUALITY.comment=Общее качество теней от солнца.
option.TOON_BANDING=Тун-освещение
option.TOON_BANDING.comment=Аниме-свет как в Genshin: яркость делится на ступени (тень/полусвет/свет).
option.LIGHTSHAFT_QUALI_DEFINE=Лучи света
option.LIGHTSHAFT_QUALI_DEFINE.comment=Солнечные лучи (god rays). Дорого по FPS на высоких значениях.
option.ATM_FOG_DISTANCE=Дальность тумана
option.ATM_FOG_DISTANCE.comment=Насколько далеко видно сквозь туман. Меньше — туманнее, как в Мондштадте.
option.PIXEL_SCALE=Разрешение рендера
option.PIXEL_SCALE.comment=Масштаб рендера: ниже — больше FPS, выше — чётче картинка.
option.MOTION_BLUR_EFFECT=Размытие в движении
option.MOTION_BLUR_EFFECT.comment=Смазывает картинку при движении камеры. Для Геншина обычно выключено.
option.BLOOM_ENABLED=Свечение (Bloom)
option.BLOOM_ENABLED.comment=Свечение ярких объектов, как в Genshin.
option.FXAA_DEFINE=Сглаживание (FXAA)
option.FXAA_DEFINE.comment=Сглаживание краёв. Дёшево по FPS.
option.ENTITY_SHADOW=Тени сущностей
option.ENTITY_SHADOW.comment=Тени от мобов и предметов. Дорого по FPS.
option.PLAYER_SHADOW=Тень игрока
option.PLAYER_SHADOW.comment=Тень от игрока (и других игроков).

